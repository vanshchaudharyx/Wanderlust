<% layout("layouts/boilerplate")%>
    <div class="row">
        <div class="col-8 offset-2">
            <h3>Create a New Listing</h3>
            <br><br>

            <form method="POST" action="/listings" novalidate class="needs-validation">
                <div class="mb-2">
                    <lable for="title" class="form-label">Title</lable>
                    <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control" required />
                </div>

                <br><br>
                <div class="mb-2">
                    <lable for="description" class="form-label">Description</lable>
                    <textarea name="lisiting[description]" placeholder="Enter description"
                        class="form-control" required></textarea>
                </div>
                <br><br>
                <div class="mb-2">
                    <lable for="image" class="form-label">Image Link</lable>
                    <input name="listing[image]" placeholder="Enter image URL/Link" type="text" class="form-control"  />
                </div>
                <br><br>
                <div class="row">
                    <div class="mb-2 col-4">
                        <lable for="price" class="form-label">Price</lable>
                        <input name="listing[price]" placeholder="1200" type="number" class="form-control" required/>
                    </div>
                    <br><br>
                    <div class="mb-2 col-md-8">
                        <lable for="country" class="form-label">Country</lable>
                        <input name="listing[country]" placeholder="India" type="text" class="form-control" required />
                    </div>
                </div>
                <br><br>
                <div class="mb-2">
                    <lable for="location" class="form-label">Location</lable>
                    <input name="listing[location]" placeholder="Jaipur,Rajsthan" type="text" class="form-control" required />
                </div>
                <br><br>

                <button class="btn btn-dark add-btn">Add</button>
                <br><br><br>

            </form>
        </div>
    </div>