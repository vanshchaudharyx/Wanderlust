<% layout('/layouts/boilerplate') -%>

<div class="row mt-4">
  <div class="col-12 col-md-10 offset-md-1">
    <h3><i class="fa-solid fa-house-chimney-user me-2"></i>Reservations</h3>
    <p class="text-muted">Manage booking requests on your listings.</p>
    <hr>

    <% if (bookings.length === 0) { %>
      <div class="text-center py-5">
        <i class="fa-solid fa-calendar-xmark fa-3x mb-3 text-muted"></i>
        <p class="text-muted">No reservations yet on your listings.</p>
      </div>
    <% } else { %>

      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th>Listing</th>
              <th>Guest</th>
              <th>Check-in</th>
              <th>Check-out</th>
              <th>Guests</th>
              <th>Total (&#x20B9;)</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% for (let booking of bookings) { %>
              <% if (booking.listing && booking.user) { %>
                <tr>
                  <td><strong><%= booking.listing.title %></strong></td>
                  <td>@<%= booking.user.username %></td>
                  <td><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" }) %></td>
                  <td><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" }) %></td>
                  <td><%= booking.guests %></td>
                  <td><%= booking.totalPrice.toLocaleString("en-IN") %></td>
                  <td>
                    <span class="badge booking-badge-<%= booking.status %>">
                      <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
                    </span>
                  </td>
                  <td>
                    <% if (booking.status === "pending") { %>
                      <form action="/bookings/<%= booking._id %>/status?_method=PATCH" method="POST" class="d-inline">
                        <input type="hidden" name="status" value="confirmed">
                        <button class="btn btn-sm btn-success me-1">Confirm</button>
                      </form>
                      <form action="/bookings/<%= booking._id %>/status?_method=PATCH" method="POST" class="d-inline"
                            onsubmit="return confirm('Reject this booking?')">
                        <input type="hidden" name="status" value="cancelled">
                        <button class="btn btn-sm btn-outline-danger">Reject</button>
                      </form>
                    <% } else { %>
                      <span class="text-muted small">—</span>
                    <% } %>
                  </td>
                </tr>
              <% } %>
            <% } %>
          </tbody>
        </table>
      </div>

    <% } %>
  </div>
</div>
