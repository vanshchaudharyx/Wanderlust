<% layout('/layouts/boilerplate') -%>

<div class="row mt-4 mb-5">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    <div class="card shadow-sm border p-4 p-md-5">
      <div class="d-flex align-items-center mb-4">
        <i class="fa-solid fa-file-contract fa-2x text-danger me-3"></i>
        <div>
          <h2 class="mb-0 fw-bold">Terms of Service</h2>
          <small class="text-muted">Last updated: November 2026</small>
        </div>
      </div>
      <hr>

      <section class="mb-4">
        <h4>1. Acceptance of Terms</h4>
        <p class="text-muted">
          By accessing or using Wanderlust, you agree to comply with and be bound by these Terms of Service. If you do not agree to these terms, please do not use our platform.
        </p>
      </section>

      <section class="mb-4">
