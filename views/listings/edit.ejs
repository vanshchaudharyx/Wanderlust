<% layout("/layouts/boilerplate") %>

    <div class="row">
        <div class="col-8 offset-2">
            <h3>Edit your listing</h3>
            <br><br>

            <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation"
                enctype="multipart/form-data">
                <div class="mb-2">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" value="<%=listing.title%>" type="text" class="form-control" required />
                    <div class="valid-feedback">
                        Title looks good!
                    </div>
                </div>

                <br><br>
                <div class="mb-2">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" class="form-control"
                        required><%=listing.description%></textarea>
                    <div class="invalid-feedback">
                        Please enter a short description.
                    </div>
                </div>
                <br><br>
                <div class="mb-2">
                    <img src="<%=originalImageUrl%>" style="width: 250px; height: 300px; object-fit: cover;">
                </div>

                <div class="mb-2">
                    <label for="image" class="form-label">Upload New Image</label>
                    <input name="listing[image]" type="file" class="form-control" />
                </div>
                <br><br>
                <div class="row">
                    <div class="mb-2 col-4">
                        <label for="price" class="form-label">Price</label>
                        <input name="listing[price]" value="<%=listing.price%>" type="number" class="form-control"
                            required />
                        <div class="invalid-feedback">
                            Please enter a valid Price.
                        </div>
                    </div>
                    <div class="mb-2 col-4">
                        <label for="maxGuests" class="form-label">Max Guests</label>
                        <input name="listing[maxGuests]" type="number" value="<%=listing.maxGuests || 4%>" min="1" class="form-control" required />
                        <div class="invalid-feedback">
                            Please enter max guests (min 1).
                        </div>
                    </div>
                    <div class="mb-2 col-md-4">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]" value="<%=listing.country%>" type="text" class="form-control"
                            required />
                        <div class="invalid-feedback">
                            Country name should be valid.
                        </div>
                    </div>
                </div>
                <br><br>
                <div class="mb-2">
                    <label for="location" class="form-label">Location</label>
                    <input name="listing[location]" value="<%=listing.location%>" type="text" class="form-control"
                        required />
                    <div class="invalid-feedback">
                        Location should be valid.
                    </div>
                </div>
                <br><br>
                <div class="mb-2">
                    <label for="category" class="form-label">Category</label>
                    <select name="listing[category]" id="category" class="form-select" required>
                        <option value="" disabled <%- !listing.category ? 'selected' : '' %>>-- Select a category --</option>
                        <% const categories = ["Trending","Rooms","Iconic Cities","Mountains","Castles","Amazing Pools","Camping","Farms","Arctic"]; %>
                        <% for (let cat of categories) { %>
                            <option value="<%= cat %>" <%- listing.category === cat ? 'selected' : '' %>><%= cat %></option>
                        <% } %>
                    </select>
                    <div class="invalid-feedback">
                        Please select a category.
                    </div>
                </div>
                <br><br>

                <button class="btn btn-dark edit-btn">Edit</button>
                <br><br><br>

            </form>
        </div>
    </div>