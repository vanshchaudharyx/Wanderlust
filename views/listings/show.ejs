<% layout('/layouts/boilerplate') -%>
    <script>
        const mapToken = "<%=process.env.MAP_TOKEN%>";
        const listing =<%-JSON.stringify(listing) %>;
        
    </script>

    <div class="row">
        <div class="col-12 col-md-8 offset-md-3">
            <h3>
                <%=listing.title%>
            </h3>
        </div>
        <div class="card col-12 col-md-6 offset-md-3 show-card listing-card">

            <img src=" <%=listing.image.url%>" class="card-img-top show-img" alt="listing-image">
            <div class="card-body">
                <p class="card-text"><b>Owned By:</b>
                    <i>
                        <%=listing.owner.username%>
                    </i>
                </p>

                <p class="card-text">
                    <%=listing.description%>
                </p>
                <p class="card-text"> &#x20B9;<%=listing.price.toLocaleString("en-IN")%></p>
                <p class="card-text">
                    <%=listing.location%>
                </p>
                <p class="card-text">
                    <%=listing.country%>
                </p>


            </div>
        </div>

        <br>
        <% if(typeof currUser !== "undefined" && currUser && listing.owner._id.equals(currUser._id)) { %>
            <div class="btns">
                <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark col-md-1 offset-md-3 edit-btn">Edit</a>
                <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                    <button class="btn btn-dark offset-md-3 delete-btn">Delete</button>
                </form>
            </div>
        <% } %>

        <!-- ===== BOOKING CARD ===== -->
        <% if (typeof currUser !== "undefined" && currUser && !listing.owner._id.equals(currUser._id)) { %>
        <div class="col-12 col-md-6 offset-md-3 mb-4">
            <div class="card booking-widget shadow-sm p-3">
                <h5 class="mb-1">&#x20B9;<%= listing.price.toLocaleString("en-IN") %> <span class="fs-6 fw-normal text-muted">/ night</span></h5>
                <form action="/listings/<%=listing._id%>/bookings" method="POST" class="needs-validation" novalidate id="bookingForm">
                    <div class="row g-2 mt-1">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">CHECK-IN</label>
                            <input type="date" name="booking[checkIn]" id="checkIn" class="form-control" required>
                            <div class="invalid-feedback">Please select a check-in date.</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">CHECK-OUT</label>
                            <input type="date" name="booking[checkOut]" id="checkOut" class="form-control" required>
                            <div class="invalid-feedback">Please select a check-out date.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">GUESTS <span class="fw-normal text-muted">(max <%=listing.maxGuests || 4%>)</span></label>
                            <input type="number" name="booking[guests]" id="guests" class="form-control" value="1" min="1" max="<%=listing.maxGuests || 4%>" required>
                            <div class="invalid-feedback">Please enter between 1 and <%=listing.maxGuests || 4%> guests.</div>
                        </div>
                    </div>
                    <!-- Live price breakdown -->
                    <div id="priceBreakdown" class="mt-3 p-2 border rounded d-none">
                        <div class="d-flex justify-content-between small">
                            <span id="nightsLabel">0 nights × &#x20B9;<%= listing.price.toLocaleString("en-IN") %></span>
                            <span id="totalPrice"></span>
                        </div>
                        <hr class="my-1">
                        <div class="d-flex justify-content-between fw-semibold">
                            <span>Total</span>
                            <span id="totalPriceBold"></span>
                        </div>
                    </div>
                    <button class="btn btn-dark w-100 mt-3">Reserve</button>
                </form>
                <p class="text-center small text-muted mt-2 mb-0">You won't be charged yet</p>
            </div>
        </div>
        <% } else if (typeof currUser === "undefined" || !currUser) { %>
        <div class="col-12 col-md-6 offset-md-3 mb-4">
            <div class="card booking-widget shadow-sm p-3 text-center">
                <h5 class="mb-1">&#x20B9;<%= listing.price.toLocaleString("en-IN") %> <span class="fs-6 fw-normal text-muted">/ night</span></h5>
                <p class="text-muted mt-2 mb-2 small">Log in to book this listing.</p>
                <a href="/login" class="btn btn-dark w-100">Log in</a>
            </div>
        </div>
        <% } %>
        <!-- ===== END BOOKING CARD ===== -->



                <div class="col-12 col-md-8 offset-md-3 mb-3">
                    <hr>
                    <% if(typeof currUser !== "undefined" && currUser) { %>
                        <h4>Leave A Review</h4>
                        <form action="/listings/<%=listing.id%>/reviews" method="POST" novalidate
                            class="needs-validation">

                            <label for="rating" class="form-label ">Rating</label>

                            <fieldset class="starability-slot">


                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1"
                                    checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                            <!-- <div class="mb-3 mt-3">

                                <label for="rating" class="form-label ">Rating</label>
                                <input type="range" min="1" max="5" id="rating" name="review[rating]"
                                    class="form-range">
                            </div> -->
                            <div class="mb-3 mt-3">
                                <label for="comment" class="form-label">Comments</label>
                                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                                    required></textarea>
                                <div class="invalid-feedback">Please add some comments for review.</div>
                            </div>
                            <button class="btn btn-outline-dark">Submit</button>
                        </form>
                        <%}%>

                            <% if(listing.reviews.length>0){%>
                                <div class="row">
                                    <p><b>All Reviews</b></p>
                                    <% for (let review of listing.reviews) { %>
                                        <div class="card col-12 col-md-5 ms-0 ms-md-3 mb-3">
                                            <div class="card-body">
                                                <h5 class="cart-title">@<%=review.author.username%>
                                                </h5>
                                                <p class="starability-result card-text" data-rating=<%=review.rating%>>

                                                </p>
                                                <p class="card-text">
                                                    <%=review.comment%>
                                                </p>



                                            </div>
                                            <form
                                                action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE"
                                                class="mb-3" method="POST">
                                                <Button class="btn btn-sm btn-dark">Delete</Button>
                                            </form>
                                        </div>


                                        <% } %>
                                </div>
                                <% } %>



                </div>
                <div class="col-12 col-md-6 offset-md-3 mb-3">
                    <h3>Where you'll be</h3>
                    <div id="map">

                    </div>
                </div>

    </div>

    <script src="/js/map.js"></script>
    <script>
        // Live price calculation for booking widget
        (function () {
            const checkInEl  = document.getElementById("checkIn");
            const checkOutEl = document.getElementById("checkOut");
            if (!checkInEl || !checkOutEl) return;

            const pricePerNight = <%- listing.price %>;
            const maxGuests     = <%- listing.maxGuests || 4 %>;
            const breakdown     = document.getElementById("priceBreakdown");
            const nightsLabel   = document.getElementById("nightsLabel");
            const totalPrice    = document.getElementById("totalPrice");
            const totalBold     = document.getElementById("totalPriceBold");

            // Set min dates
            const todayStr = new Date().toISOString().split("T")[0];
            checkInEl.min  = todayStr;
            checkOutEl.min = todayStr;

            checkInEl.addEventListener("change", () => {
                checkOutEl.min = checkInEl.value;
                if (checkOutEl.value && checkOutEl.value <= checkInEl.value) {
                    checkOutEl.value = "";
                }
                updatePrice();
            });
            checkOutEl.addEventListener("change", updatePrice);

            function updatePrice() {
                if (!checkInEl.value || !checkOutEl.value) {
                    breakdown.classList.add("d-none");
                    return;
                }
                const msPerDay = 1000 * 60 * 60 * 24;
                const nights   = Math.round(
                    (new Date(checkOutEl.value) - new Date(checkInEl.value)) / msPerDay
                );
                if (nights <= 0) { breakdown.classList.add("d-none"); return; }

                const total = nights * pricePerNight;
                const fmt   = (n) => "\u20B9" + n.toLocaleString("en-IN");

                nightsLabel.textContent = nights + " night" + (nights > 1 ? "s" : "") + " \u00D7 " + fmt(pricePerNight);
                totalPrice.textContent  = fmt(total);
                totalBold.textContent   = fmt(total);
                breakdown.classList.remove("d-none");
            }
        })();
    </script>