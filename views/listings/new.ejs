<% layout("layouts/boilerplate")%>
    <div class="row">
        <div class="col-12 col-md-8 offset-md-2">
            <h3>Create a New Listing</h3>
            <br><br>

            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-2">
                    <lable for="title" class="form-label">Title</lable>
                    <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control"
                        required />
                    <div class="valid-feedback">
                        Title looks good!
                    </div>
                </div>

                <br><br>
                <div class="mb-2">
                    <lable for="description" class="form-label">Description</lable>
                    <textarea name="listing[description]" placeholder="Enter description" class="form-control"
                        required></textarea>
                    <div class="invalid-feedback">
                        Please enter a short description.
                    </div>
                </div>
                <br><br>
                <!-- <div class="mb-2">
                    <lable for="image" class="form-label">Image Link</lable>
                    <input name="listing[image]" placeholder="Enter image URL/Link" type="text" class="form-control" />
                </div> -->
                <div class="mb-2">
                    <lable for="image" class="form-label">Upload Listing Image</lable>
                    <input name="listing[image]" type="file" class="form-control" />
                    required
                </div>
                <br><br>
                <div class="row">
                    <div class="mb-2 col-12 col-sm-4">
                        <lable for="price" class="form-label">Price</lable>
                        <input name="listing[price]" placeholder="1200" class="form-control" required />
                        <div class="invalid-feedback">
                            Please enter a valid Price.
                        </div>
                    </div>
                    <br><br>
                    <div class="mb-2 col-12 col-sm-4">
                        <label for="maxGuests" class="form-label">Max Guests</label>
                        <input name="listing[maxGuests]" type="number" placeholder="4" min="1" class="form-control" value="4" required />
                        <div class="invalid-feedback">
                            Please enter max guests (min 1).
                        </div>
                    </div>
                    <br><br>
                    <div class="mb-2 col-12 col-sm-4">
                        <lable for="country" class="form-label">Country</lable>
                        <input name="listing[country]" placeholder="India" type="text" class="form-control" required />
                        <div class="invalid-feedback">
                            Country name should be valid.
                        </div>
                    </div>
                </div>
                <br><br>
                <div class="mb-2">
                    <lable for="location" class="form-label">Location</lable>
                    <input name="listing[location]" placeholder="Jaipur,Rajsthan" type="text" class="form-control"
                        required />
                    <div class="invalid-feedback">
                        Location should be valid.
                    </div>
                </div>
                <br><br>
                <div class="mb-2">
                    <label for="category" class="form-label">Category</label>
                    <select name="listing[category]" id="category" class="form-select" required>
                        <option value="" disabled selected>-- Select a category --</option>
                        <option value="Trending">Trending</option>
                        <option value="Rooms">Rooms</option>
                        <option value="Iconic Cities">Iconic Cities</option>
                        <option value="Mountains">Mountains</option>
                        <option value="Castles">Castles</option>
                        <option value="Amazing Pools">Amazing Pools</option>
                        <option value="Camping">Camping</option>
                        <option value="Farms">Farms</option>
                        <option value="Arctic">Arctic</option>
                    </select>
                    <div class="invalid-feedback">
                        Please select a category.
                    </div>
                </div>
                <br><br>

                <button class="btn btn-dark add-btn">Add</button>
                <br><br><br>

            </form>
        </div>
    </div>