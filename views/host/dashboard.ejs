<% layout('/layouts/boilerplate') -%>

<div class="row mt-4 mb-5">
  <div class="col-12 col-lg-10 offset-lg-1">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <div>
        <h2><i class="fa-solid fa-chart-line me-2 text-danger"></i>Host Dashboard</h2>
        <p class="text-muted mb-0">Overview of your listings, earnings, and reservations.</p>
      </div>
      <div>
        <a href="/listings/new" class="btn btn-danger add-btn">
          <i class="fa-solid fa-plus me-1"></i> Add Listing
        </a>
      </div>
    </div>
    <hr class="mb-4">

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100 p-3 border">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted small text-uppercase mb-1 fw-semibold">Total Listings</p>
              <h3 class="mb-0 fw-bold"><%= totalListings %></h3>
            </div>
            <div class="fs-1 text-primary opacity-75">
              <i class="fa-solid fa-house-chimney"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100 p-3 border">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted small text-uppercase mb-1 fw-semibold">Total Bookings</p>
              <h3 class="mb-0 fw-bold"><%= totalBookings %></h3>
            </div>
            <div class="fs-1 text-info opacity-75">
              <i class="fa-solid fa-calendar-check"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100 p-3 border">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted small text-uppercase mb-1 fw-semibold">Earned Amount</p>
              <h3 class="mb-0 fw-bold text-success">&#x20B9;<%= earnedAmount.toLocaleString("en-IN") %></h3>
            </div>
            <div class="fs-1 text-success opacity-75">
              <i class="fa-solid fa-wallet"></i>
            </div>
          </div>
          <small class="text-muted mt-2">Past completed bookings</small>
        </div>
      </div>

      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm h-100 p-3 border">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted small text-uppercase mb-1 fw-semibold">Expected Amount</p>
              <h3 class="mb-0 fw-bold text-warning">&#x20B9;<%= expectedAmount.toLocaleString("en-IN") %></h3>
            </div>
            <div class="fs-1 text-warning opacity-75">
              <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
          </div>
          <small class="text-muted mt-2">Upcoming / active stays</small>
        </div>
      </div>
    </div>

    <!-- Section 1: Pending Booking Requests -->
    <div class="card shadow-sm mb-4 border">
      <div class="card-header bg-transparent d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
        <h5 class="mb-0">
          <i class="fa-solid fa-bell me-2 text-warning"></i>Pending Requests
          <span class="badge bg-warning text-dark ms-2"><%= pendingRequests.length %></span>
        </h5>
        <a href="/bookings/reservations" class="btn btn-sm btn-outline-secondary">View All Reservations</a>
      </div>
      <div class="card-body p-0">
        <% if (pendingRequests.length === 0) { %>
          <div class="text-center py-4 text-muted">
            <i class="fa-regular fa-circle-check fa-2x mb-2 text-success"></i>
            <p class="mb-0">No pending requests waiting for your approval.</p>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Listing</th>
                  <th>Guest</th>
                  <th>Dates</th>
                  <th>Guests</th>
                  <th>Price</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% for (let req of pendingRequests) { %>
                  <tr>
                    <td>
                      <a href="/listings/<%= req.listing._id %>" class="text-decoration-none fw-semibold">
                        <%= req.listing.title %>
                      </a>
                    </td>
                    <td>@<%= req.user.username %></td>
                    <td>
                      <%= new Date(req.checkIn).toLocaleDateString("en-IN", { day:"numeric", month:"short" }) %> &ndash; 
                      <%= new Date(req.checkOut).toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" }) %>
                    </td>
                    <td><%= req.guests %></td>
                    <td><strong>&#x20B9;<%= req.totalPrice.toLocaleString("en-IN") %></strong></td>
                    <td>
                      <form action="/bookings/<%= req._id %>/status?_method=PATCH" method="POST" class="d-inline">
                        <input type="hidden" name="status" value="confirmed">
                        <button class="btn btn-sm btn-success me-1">Confirm</button>
                      </form>
                      <form action="/bookings/<%= req._id %>/status?_method=PATCH" method="POST" class="d-inline" onsubmit="return confirm('Reject this booking request?')">
                        <input type="hidden" name="status" value="cancelled">
                        <button class="btn btn-sm btn-outline-danger">Reject</button>
                      </form>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Section 2: Upcoming Guests Table -->
    <div class="card shadow-sm border">
      <div class="card-header bg-transparent py-3">
        <h5 class="mb-0">
          <i class="fa-solid fa-user-check me-2 text-success"></i>Upcoming Guests
          <span class="badge bg-success ms-2"><%= upcomingGuests.length %></span>
        </h5>
      </div>
      <div class="card-body p-0">
        <% if (upcomingGuests.length === 0) { %>
          <div class="text-center py-4 text-muted">
            <i class="fa-solid fa-calendar-xmark fa-2x mb-2"></i>
            <p class="mb-0">No upcoming confirmed guests scheduled.</p>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead>
                <tr>
                  <th>Guest Name</th>
                  <th>Listing</th>
                  <th>Dates</th>
                  <th>Guests</th>
                  <th>Price</th>
                </tr>
              </thead>
              <tbody>
                <% for (let guest of upcomingGuests) { %>
                  <tr>
                    <td>
                      <i class="fa-regular fa-user me-1 text-muted"></i>
                      <strong>@<%= guest.user.username %></strong>
                    </td>
                    <td>
                      <a href="/listings/<%= guest.listing._id %>" class="text-decoration-none">
                        <%= guest.listing.title %>
                      </a>
                    </td>
                    <td>
                      <i class="fa-regular fa-calendar me-1 text-muted"></i>
                      <%= new Date(guest.checkIn).toLocaleDateString("en-IN", { day:"numeric", month:"short" }) %> &ndash; 
                      <%= new Date(guest.checkOut).toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" }) %>
                    </td>
                    <td><%= guest.guests %></td>
                    <td><strong class="text-success">&#x20B9;<%= guest.totalPrice.toLocaleString("en-IN") %></strong></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</div>
